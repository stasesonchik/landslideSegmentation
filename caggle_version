def denormalize(tensor):
    mean,std = np.array([0.485,0.456,0.406]), np.array([0.229,0.224,0.225])
    img = tensor.clone().permute(1,2,0).cpu().numpy()
    img = img*std + mean
    return np.clip(img,0,1)

def visualize(image, mask, title="Sample"):
    color_map = np.array([[0,0,0],[0,0,255],[255,255,0]],dtype=np.uint8)
    color_mask = color_map[mask]
    overlay = cv2.addWeighted((image*255).astype(np.uint8),0.6,color_mask,0.4,0)
    fig, (ax1,ax2,ax3) = plt.subplots(1,3,figsize=(10,3))
    ax1.imshow(image); ax1.axis('off'); ax1.set_title("Original")
    ax2.imshow(color_mask); ax2.axis('off'); ax2.set_title("Mask")
    ax3.imshow(overlay); ax3.axis('off'); ax3.set_title("Overlay")
    plt.suptitle(title)
    plt.show()

